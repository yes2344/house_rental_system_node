{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Node API (local development)",
      "type": "process",
      "command": "npm",
      "args": [
        "start"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "node-api",
        "pattern": {
          "regexp": "^(?!)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^> house-sales-rental-api@",
          "endsPattern": "^Node API listening on port "
        }
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
